# .env 로 복사해서 쓰세요. 모두 선택 사항 — 없어도 모든 기본 기능이 동작합니다. (.env 는 git 에 올리지 않음)

# Claude API: 있으면 (a) 한국어 주제 → 영어 키워드 자동 생성, (b) --ko-summary 한국어 3줄 요약
ANTHROPIC_API_KEY=

# 무료 키를 넣으면 요청 한도가 늘어납니다 (같은 IP 를 여러 사람이 쓰는 네트워크에서 429 가 나면 필수)
OPENALEX_API_KEY=            # https://openalex.org 에서 무료 발급
SEMANTIC_SCHOLAR_API_KEY=    # https://www.semanticscholar.org/product/api#api-key-form

# 아직 미구현 출처 (TODO.md 참고) — 키가 있어도 지금은 사용되지 않습니다
CORE_API_KEY=
DATAGO_API_KEY=
KCI_API_KEY=

# 설정 파일 경로를 바꾸고 싶을 때
# FINDER_CONFIG=config.yaml
# FINDER_CONTACT_EMAIL=you@example.com
# FINDER_DOWNLOAD_DIR=downloads
